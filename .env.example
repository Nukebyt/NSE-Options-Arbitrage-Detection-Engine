# Upstox Analytics access token (account.upstox.com/developer/apps -> Analytics tab ->
# Generate Token). 365-day validity, read-only, covers Market Data + Real-time & Streaming --
# no OAuth2 redirect flow needed for this project. See FOUNDATIONS.md S39.
# NEVER paste the actual token value in chat, a commit, or anywhere outside this file.
UPSTOX_ACCESS_TOKEN=

# Upstox full OAuth2 App credentials (account.upstox.com/developer/apps -> +App), tested
# (BUGS.md DEC-5) to see if a full-App token unlocks WebSocket depth streaming (full_d5)
# that the Analytics token above couldn't reach. See FOUNDATIONS.md S39 Path A.
# UPSTOX_REDIRECT_URI must match EXACTLY what you entered when creating the app.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
# Populated by the OAuth2 exchange at runtime, not something you fill in by hand --
# and unlike the Analytics token, this one likely expires daily (verify once we test it).
UPSTOX_OAUTH_ACCESS_TOKEN=
